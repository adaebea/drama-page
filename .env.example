## Stripe
# Required
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PRICE_ID=price_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Choose exactly ONE mode (do not define STRIPE_CHECKOUT_MODE twice):
# - subscription: supports trial period via STRIPE_TRIAL_PERIOD_DAYS
# - payment: one-time payment, trial period is ignored
STRIPE_CHECKOUT_MODE=subscription
STRIPE_TRIAL_PERIOD_DAYS=3
# STRIPE_CHECKOUT_MODE=payment

# Optional URLs (defaults to current host)
# STRIPE_SUCCESS_URL=https://your-domain.com/success.html?session_id={CHECKOUT_SESSION_ID}
# STRIPE_CANCEL_URL=https://your-domain.com/

## Kalos code storage
# Recommended for production: Vercel KV / Upstash Redis REST credentials
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional custom Redis keys
# KALOS_KV_STORE_KEY=kalos:store
# KALOS_KV_LOCK_KEY=kalos:store:lock
# Seed codes securely from env instead of committing them to Git
# KALOS_CODES_JSON=["KALOS-GIFT-1001","KALOS-GIFT-1002"]
# KALOS_CODES_CSV=KALOS-GIFT-1001,KALOS-GIFT-1002

## Meta (Pixel / CAPI)
META_PIXEL_ID=your_meta_pixel_id
META_ACCESS_TOKEN=your_meta_conversions_api_access_token
# META_GRAPH_API_VERSION=v21.0
# META_TEST_EVENT_CODE=
